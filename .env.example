# Copy this file to .env (in this same directory) and fill in real values.
# .env is git-ignored — this file (.env.example) is the only one committed.
#
#   Run:
#   cp .env.example .env

# --- Telegram bot ---
# Get BOT_TOKEN from @BotFather on Telegram.
# ADMIN_ID is your own numeric Telegram user ID (get it from @userinfobot) —
# this is the account that gets admin-panel access via the bot.
BOT_TOKEN=your-bot-token-here
ADMIN_ID=your-telegram-user-id-here

# --- Webhook ---
# WEBHOOK_URL is your deployed backend's public URL + /webhook
# (e.g. https://your-app.onrender.com/webhook).
# WEBHOOK_SECRET is any random string you choose yourself — it's checked on
# every incoming webhook request to confirm it's really coming from Telegram.
WEBHOOK_URL=https://your-backend-url.example.com/webhook
WEBHOOK_SECRET=choose-any-random-string-here

# --- Database ---
# Full Postgres connection string, e.g. from Render or Neon.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Admin REST auth ---
# Required in the X-Admin-Token header on admin REST endpoints
# (add/edit product, list orders, change order status). Any random string.
ADMIN_API_TOKEN=choose-another-random-string-here

# --- Shop identity ---
SHOP_NAME=My Shop
SHOP_FRONTEND_URL=https://your-frontend-url.example.com